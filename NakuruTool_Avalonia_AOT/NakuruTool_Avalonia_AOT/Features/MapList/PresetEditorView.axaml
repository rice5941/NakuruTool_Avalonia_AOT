<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:MapList="using:NakuruTool_Avalonia_AOT.Features.MapList"
             xmlns:models="using:NakuruTool_Avalonia_AOT.Features.MapList.Models"
             xmlns:osu="using:NakuruTool_Avalonia_AOT.Features.OsuDatabase"
             xmlns:converters="using:NakuruTool_Avalonia_AOT.Features.Shared.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:translate="using:NakuruTool_Avalonia_AOT.Features.Translate"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="NakuruTool_Avalonia_AOT.Features.MapList.PresetEditorView"
             x:DataType="MapList:PresetEditorViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.filter-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey6}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="TextBox.filter-input">
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Styles>

    <!-- 外枠: 2行構成 ヘッダー/コンテンツ -->
    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: ヘッダー -->
        <Border Grid.Row="0"
                Background="{DynamicResource SemiGrey1}"
                BorderBrush="{DynamicResource SemiGrey3}"
                BorderThickness="1,1,1,0"
                CornerRadius="4,4,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="PlaylistEdit" Width="20" Height="20" Foreground="{DynamicResource SemiBluePrimary}"/>
                <TextBlock Text="{translate:Translate 'Preset.EditorTitle'}"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Row 1: コンテンツ（左右分割） -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SemiGrey3}"
                BorderThickness="1"
                CornerRadius="0,0,4,4">
            <Grid >
                <Grid.ColumnDefinitions>
				    <ColumnDefinition MinWidth="400" Width="400"/>
				    <ColumnDefinition Width="8"/>
				    <ColumnDefinition Width="*"/>	
                </Grid.ColumnDefinitions>

                <!-- Col 0: プリセット一覧パネル -->
                <Grid Grid.Column="0"
                      RowDefinitions="*,Auto">

                    <!-- Row 0: プリセット一覧 + 追加ボタン -->
                    <Grid Grid.Row="0"
                          RowDefinitions="*,Auto"
                          IsEnabled="{Binding IsNotBatchGenerating}">

                        <!-- Row 0: プリセット一覧 -->
                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding Presets}"
                                 SelectedItem="{Binding SelectedPreset}"
                                 Margin="8,8,4,4">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:FilterPreset">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Margin="4,2"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                                        <Button Grid.Column="1"
                                                Width="24" Height="24" Padding="0"
                                                Command="{Binding $parent[ListBox].((MapList:PresetEditorViewModel)DataContext).DeletePresetCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Right"
                                                ToolTip.Tip="{translate:Translate 'Preset.Delete'}">
                                            <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Row 1: 追加ボタン -->
                        <Button Grid.Row="1"
                                Command="{Binding AddNewPresetCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="8,2,4,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                                <TextBlock Text="{translate:Translate 'Preset.AddNew'}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Row 1: 一括生成セクション（リスト外・ボーダー付き） -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource SemiGrey3}"
                            BorderThickness="0,1,0,0"
                            Background="{DynamicResource SemiGrey1}"
                            Padding="8">
                        <StackPanel Spacing="6">
                            <Button Command="{Binding BatchGenerateCollectionsCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="PlaylistPlay" Width="16" Height="16"/>
                                    <TextBlock Text="{translate:Translate 'Preset.BatchGenerate'}"/>
                                </StackPanel>
                            </Button>

                            <!-- 一括生成進捗 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding BatchGenerationStatusMessage}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SemiGrey6}"/>
                                <ProgressBar Value="{Binding BatchGenerationProgress}"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="6"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Col 1: GridSplitter -->
                <GridSplitter Grid.Column="1"
                              Width="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>

                <!-- Col 2: 右側 編集パネル -->
                <Grid Grid.Column="2"
                      RowDefinitions="Auto,*,Auto"
                      IsEnabled="{Binding IsNotBatchGenerating}">

                    <!-- プリセット未選択時: 中央メッセージ -->
                    <TextBlock Grid.Row="0" Grid.RowSpan="3"
                               Text="{translate:Translate 'Preset.SelectToEdit'}"
                               IsVisible="{Binding !HasSelectedPreset}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiGrey5}"
                               FontSize="14"/>

                    <!-- プリセット選択時: Row 0 プリセット名テキストボックス -->
                    <StackPanel Grid.Row="0"
                                IsVisible="{Binding HasSelectedPreset}"
                                Spacing="4"
                                Margin="4,8,8,4">
                        <TextBlock Classes="filter-label"
                                   Text="{translate:Translate 'Preset.PresetName'}"/>
                        <TextBox Classes="filter-input"
                                 Text="{Binding EditingPresetName}"
                                 PlaceholderText="{translate:Translate 'Preset.EnterPresetName'}"/>
                    </StackPanel>

                    <!-- プリセット選択時: Row 1 フィルタ条件リスト（ScrollViewer内） -->
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding HasSelectedPreset}"
                                  VerticalScrollBarVisibility="Auto">
                        <MapList:FilterGroupsEditorView DataContext="{Binding Editor}"
                                                        Margin="4,4,8,8"/>
                    </ScrollViewer>

                    <!-- プリセット選択時: Row 2 操作ボタン（スクロール外・常時表示） -->
                    <Border Grid.Row="2"
                            IsVisible="{Binding HasSelectedPreset}"
                            BorderBrush="{DynamicResource SemiGrey3}"
                            BorderThickness="0,1,0,0"
                            Background="{DynamicResource SemiGrey1}"
                            Padding="8">
                        <StackPanel Spacing="6">
                            <!-- ステータスメッセージ -->
                            <TextBlock Text="{Binding EditorStatusMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SemiGrey6}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                            <Button Command="{Binding Editor.AddGroupCommand}"
                                    IsVisible="{Binding Editor.HasConditions}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    ToolTip.Tip="{translate:Translate 'MapFilter.AddGroupTip'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                                    <TextBlock Text="{translate:Translate 'MapFilter.AddGroup'}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding Editor.ClearCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="DeleteSweep" Width="16" Height="16"/>
                                    <TextBlock Text="{translate:Translate 'MapFilter.ClearConditions'}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SavePresetCommand}"
                                    Theme="{StaticResource SolidButton}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="ContentSave" Width="16" Height="16"/>
                                    <TextBlock Text="{translate:Translate 'Preset.Save'}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

    </Grid>

</UserControl>