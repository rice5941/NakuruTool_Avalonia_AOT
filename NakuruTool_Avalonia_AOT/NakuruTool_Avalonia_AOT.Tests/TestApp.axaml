<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:Mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NakuruTool_Avalonia_AOT.Tests.TestApp"
             RequestedThemeVariant="Light">
  
    <Application.Styles>
        <semi:SemiTheme Locale="ja-JP" />
        <semi:DataGridSemiTheme />
        <Mi:MaterialIconStyles />
        <!-- App.axaml と同じ Material.Icons 3.x 互換スタイル（既定サイズ 16x16） -->
        <Style Selector="Mi|MaterialIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Window">
            <Setter Property="FontFamily" 
                    Value="Meiryo, Yu Gothic UI, Hiragino Sans, Noto Sans CJK JP, sans-serif" />
        </Style>
    </Application.Styles>
</Application>
