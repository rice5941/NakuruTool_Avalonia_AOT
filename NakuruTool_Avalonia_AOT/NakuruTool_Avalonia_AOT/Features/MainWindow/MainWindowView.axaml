<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mainWindow="using:NakuruTool_Avalonia_AOT.Features.MainWindow"
        xmlns:osuDatabase="using:NakuruTool_Avalonia_AOT.Features.OsuDatabase"
        xmlns:converters="using:NakuruTool_Avalonia_AOT.Features.Shared.Converters"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        xmlns:translate="using:NakuruTool_Avalonia_AOT.Features.Translate"
        x:Class="NakuruTool_Avalonia_AOT.Features.MainWindow.MainWindowView"
        x:DataType="mainWindow:MainWindowViewModel"
        Icon="/Assets/Nakurage-dot.ico"
        Title="{translate:Translate 'App.Name'}"
        MinWidth="800"
        MinHeight="500">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- サイドバーのカテゴリ見出し -->
        <ControlTheme x:Key="SidebarSectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </ControlTheme>

        <ControlTheme x:Key="PageStackPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="8"/>
        </ControlTheme>

        <ControlTheme x:Key="PageTextBlock" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- ToggleButton のアイコン切り替え（チェック状態 = サイドバーを閉じている） -->
        <Style Selector="ToggleButton#ExpandButton > mi|MaterialIcon">
            <Setter Property="Kind" Value="MenuClose"/>
        </Style>
        <Style Selector="ToggleButton#ExpandButton:checked > mi|MaterialIcon">
            <Setter Property="Kind" Value="MenuOpen"/>
        </Style>

        <!-- DrawerPage 標準のトップバー（ハンバーガーボタン）は使わず、ヘッダーの ExpandButton で開閉する -->
        <Style Selector="DrawerPage#MainDrawer /template/ Border#PART_TopBar">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- サイドバーのメニュー一覧 -->
        <Style Selector="ListBox.SidebarMenu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ListBox.SidebarMenu > ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- 旧 TabControl(ScrollLineTabControl) と同じく、開いていないページの項目は Semi の淡いテキスト色(SemiColorText2)で表示し、
             ホバー中・選択中の項目は通常のテキスト色に戻す。TextBlock / MaterialIcon は ContentPresenter の Foreground を継承する -->
        <Style Selector="ListBox.SidebarMenu > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TabItemLineHeaderForeground}"/>
        </Style>
        <Style Selector="ListBox.SidebarMenu > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TabItemLineHeaderPointeroverForeground}"/>
        </Style>
        <Style Selector="ListBox.SidebarMenu > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TabItemLineHeaderSelectedForeground}"/>
        </Style>
    </Window.Styles>

    <!-- Panelでオーバーレイを重ねる -->
    <Panel>
        <!-- メインコンテンツ -->
        <Grid RowDefinitions="Auto, *">
            <!-- ヘッダーバー -->
            <Border Grid.Row="0" Margin="8" Padding="8" Theme="{DynamicResource CardBorder}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton Name="ExpandButton" Padding="4"
                                  IsChecked="{Binding #MainDrawer.IsOpen, Mode=TwoWay, Converter={StaticResource InverseBooleanConverter}}">
                        <mi:MaterialIcon Width="20" Height="20"/>
                    </ToggleButton>
                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="Bold"
                               Text="{translate:Translate 'App.Name'}"/>
                </StackPanel>
            </Border>

            <!-- Avalonia 12 の Page ベースナビゲーション:
                 DrawerPage（左サイドバー）+ NavigationPage（コンテンツ領域）+ ContentPage（各ページ） -->
            <DrawerPage Grid.Row="1"
                        Name="MainDrawer"
                        Margin="8,0"
                        IsOpen="True"
                        IsGestureEnabled="False"
                        DrawerBehavior="Auto"
                        DrawerLayoutBehavior="Split"
                        DrawerPlacement="Left"
                        DrawerLength="240"
                        CompactDrawerLength="0">

                <DrawerPage.Drawer>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,8">
                            <!-- メイン -->
                            <TextBlock Theme="{StaticResource SidebarSectionHeader}"
                                       Text="{translate:Translate 'Menu.Main'}"/>
                            <ListBox Name="MainMenu"
                                     Classes="SidebarMenu"
                                     SelectionChanged="OnMenuSelectionChanged">
                                <ListBoxItem Tag="{x:Static mainWindow:MainPageKind.MapList}">
                                    <StackPanel Theme="{StaticResource PageStackPanel}">
                                        <mi:MaterialIcon Kind="Search" Width="20" Height="20"/>
                                        <TextBlock Text="{translate:Translate 'Menu.MapList'}" Theme="{StaticResource PageTextBlock}"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static mainWindow:MainPageKind.ImportExport}">
                                    <StackPanel Theme="{StaticResource PageStackPanel}">
                                        <mi:MaterialIcon Kind="ImportExport" Width="20" Height="20"/>
                                        <TextBlock Text="{translate:Translate 'Menu.ImportExport'}" Theme="{StaticResource PageTextBlock}"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static mainWindow:MainPageKind.BeatmapGeneration}">
                                    <StackPanel Theme="{StaticResource PageStackPanel}">
                                        <mi:MaterialIcon Kind="Creation" Width="20" Height="20"/>
                                        <TextBlock Text="{translate:Translate 'Menu.BeatmapGeneration'}" Theme="{StaticResource PageTextBlock}"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>

                            <!-- システム -->
                            <TextBlock Theme="{StaticResource SidebarSectionHeader}"
                                       Text="{translate:Translate 'Menu.Systems'}"/>
                            <ListBox Name="SystemsMenu"
                                     Classes="SidebarMenu"
                                     SelectionChanged="OnMenuSelectionChanged">
                                <ListBoxItem Tag="{x:Static mainWindow:MainPageKind.Settings}">
                                    <StackPanel Theme="{StaticResource PageStackPanel}">
                                        <mi:MaterialIcon Kind="Cog" Width="20" Height="20"/>
                                        <TextBlock Text="{translate:Translate 'Menu.Settings'}" Theme="{StaticResource PageTextBlock}"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="{x:Static mainWindow:MainPageKind.Licenses}">
                                    <StackPanel Theme="{StaticResource PageStackPanel}">
                                        <mi:MaterialIcon Kind="License" Width="20" Height="20"/>
                                        <TextBlock Text="{translate:Translate 'Menu.Licenses'}" Theme="{StaticResource PageTextBlock}"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DrawerPage.Drawer>

                <DrawerPage.Content>
                    <NavigationPage Name="MainNav"/>
                </DrawerPage.Content>
            </DrawerPage>
        </Grid>

        <!-- オーバーレイ（半透明背景） -->
        <Border IsVisible="{Binding IsLoadingOverlayVisible}" Background="#80000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- オーバーレイコンテンツ（中央配置） -->
            <Border Theme="{DynamicResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400" MaxWidth="600" Padding="16">
                <osuDatabase:DatabaseLoadingView DataContext="{Binding DatabaseLoadingViewModel}" />
            </Border>
        </Border>
    </Panel>

</Window>
