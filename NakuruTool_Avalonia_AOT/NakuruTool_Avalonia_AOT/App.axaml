<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u-semi="https://irihi.tech/ursa/themes/semi"
	         xmlns:Mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NakuruTool_Avalonia_AOT.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
  
    <Application.Styles>
        <semi:SemiTheme Locale="ja-JP" />
        <semi:DataGridSemiTheme />
        <Mi:MaterialIconStyles />
        <!-- Material.Icons 3.x で ControlTheme の既定サイズ(16x16)が廃止され、
             サイズ未指定のアイコンが FontSize 依存・片側指定のアイコンが正方形になるため 2.x の既定値を再現する。
             ローカル値(Width/Height 指定)はこの Style より優先されるので既存のサイズ指定には影響しない。 -->
        <Style Selector="Mi|MaterialIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <!-- ToolTip やドロップダウン等のポップアップは Window とは別の TopLevel(PopupRoot) に描画され、
             Window の FontFamily が継承されない(またはテーマ側の既定フォントになる)ため同じフォントを明示する。 -->
        <Style Selector="Window, PopupRoot, ToolTip">
            <Setter Property="FontFamily"
                    Value="Meiryo, Yu Gothic UI, Hiragino Sans, Noto Sans CJK JP, sans-serif" />
        </Style>
        <!-- ComboBox 既定の VirtualizingStackPanel だとスクロールで長い項目が実体化されるたびに
             ドロップダウン幅が広がるため、全項目を一度に計測する StackPanel を使用して幅を固定する。
             ローカル値(ItemsPanel 指定)はこの Style より優先されるので個別指定には影響しない。 -->
        <Style Selector="ComboBox">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>