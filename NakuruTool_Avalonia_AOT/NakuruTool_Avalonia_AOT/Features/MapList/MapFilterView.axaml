<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:MapList="using:NakuruTool_Avalonia_AOT.Features.MapList"
             xmlns:models="using:NakuruTool_Avalonia_AOT.Features.MapList.Models"
             xmlns:osu="using:NakuruTool_Avalonia_AOT.Features.OsuDatabase"
             xmlns:converters="using:NakuruTool_Avalonia_AOT.Features.Shared.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             xmlns:translate="using:NakuruTool_Avalonia_AOT.Features.Translate"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="NakuruTool_Avalonia_AOT.Features.MapList.MapFilterView"
             x:DataType="MapList:MapFilterViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.filter-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SemiGrey6}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="ComboBox.filter-combobox">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SemiGrey0}" 
            BorderBrush="{DynamicResource SemiGrey3}" 
            BorderThickness="1" CornerRadius="4"
            Padding="0,0,0,8">
		<Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{DynamicResource SemiGrey1}"
                BorderBrush="{DynamicResource SemiGrey3}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="Filter" Width="20" Height="20" Foreground="{DynamicResource SemiBluePrimary}"/>
                <TextBlock Text="{translate:Translate 'MapFilter.Title'}" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- プリセット選択 -->
        <StackPanel Grid.Row="1" Margin="8,0,8,8">
            <TextBlock Classes="filter-label" Text="{translate:Translate 'MapFilter.Preset'}" Margin="0,0,0,4"/>
            <Grid ColumnDefinitions="*,4,Auto">
                <ComboBox Grid.Column="0" Classes="filter-combobox"
                          ItemsSource="{Binding PresetsWithNone}"
                          SelectedItem="{Binding SelectedPreset}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Panel>
                                <!-- null（なし）の場合：translate:Translate で言語変更時に自動更新 -->
                                <TextBlock Text="{translate:Translate 'MapFilter.PresetNone'}"
                                           IsVisible="{Binding, Converter={x:Static converters:IsNullConverter.Instance}}"/>
                                <!-- プリセット名を表示 -->
                                <TextBlock Text="{Binding Name}"
                                           IsVisible="{Binding, Converter={x:Static converters:IsNotNullConverter.Instance}}"/>
                            </Panel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2"
                        Width="32" Height="32" Padding="0"
                        Command="{Binding TogglePresetEditorCommand}"
                        ToolTip.Tip="{translate:Translate 'Preset.OpenEditor'}">
                    <mi:MaterialIcon Kind="PlaylistEdit" Width="20" Height="20"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- フィルタ条件（組の中は「かつ」、組どうしは「または」） -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <MapList:FilterGroupsEditorView DataContext="{Binding Editor}" Margin="8,0,8,0"/>
        </ScrollViewer>

        <!-- フッター: または（別の条件の組を追加）/クリア -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="8,8,8,0">
            <Button Command="{Binding Editor.AddGroupCommand}"
                    IsVisible="{Binding Editor.HasConditions}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    ToolTip.Tip="{translate:Translate 'MapFilter.AddGroupTip'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                    <TextBlock Text="{translate:Translate 'MapFilter.AddGroup'}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding Editor.ClearCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Classes="Tertiary">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="DeleteSweep" Width="16" Height="16"/>
                    <TextBlock Text="{translate:Translate 'MapFilter.ClearConditions'}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
    </Border>
    
    
</UserControl>
