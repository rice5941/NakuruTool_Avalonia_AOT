<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 のテストプロジェクトは実行可能ファイルとしてビルドする -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 テストフレームワーク（Avalonia.Headless.XUnit 12 は xUnit v3 が必須） -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    
    <!-- Avalonia ヘッドレステスト -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    
    <!-- テーマ（ヘッドレスでも必要） -->
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- メインプロジェクトを参照 -->
    <ProjectReference Include="..\NakuruTool_Avalonia_AOT\NakuruTool_Avalonia_AOT.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- スクリーンショット出力ディレクトリ -->
    <None Update="Screenshots\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 7K 解析の検証用 fixture（原典 TypeScript の出力） -->
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 7K 解析のネイティブライブラリ（メインプロジェクトのビルドで生成される） -->
    <None Include="..\..\native\nakuru_7k_analyze\target\release\analyze_7k.dll"
          Link="analyze_7k.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\native\nakuru_7k_analyze\target\release\analyze_7k.dll')" />
  </ItemGroup>

</Project>
