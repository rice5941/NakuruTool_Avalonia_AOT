<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:Mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NakuruTool_Avalonia_AOT.Tests.TestApp"
             RequestedThemeVariant="Light">
  
    <Application.Styles>
        <semi:SemiTheme Locale="ja-JP" />
        <semi:DataGridSemiTheme />
        <Mi:MaterialIconStyles />
        <!-- App.axaml と同じ Material.Icons 3.x 互換スタイル（既定サイズ 16x16） -->
        <Style Selector="Mi|MaterialIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Window">
            <Setter Property="FontFamily"
                    Value="Meiryo, Yu Gothic UI, Hiragino Sans, Noto Sans CJK JP, sans-serif" />
        </Style>
        <!-- App.axaml と同じ Popup スタイル（ポップアップが UI 表示倍率を引き継ぐ） -->
        <Style Selector="Popup">
            <Setter Property="InheritsTransform" Value="True" />
        </Style>
        <!-- App.axaml と同じ ComboBox スタイル（ドロップダウン幅を固定するため非仮想化の StackPanel を使用） -->
        <Style Selector="ComboBox">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
